   "steps": [
    {
     "start": 0.0,
     "end": 3.6,
     "text": "On Home, tap Import your bank statement."
    },
    {
     "start": 3.6,
     "end": 7.53,
     "text": "Tap Try sample statement."
    },
    {
     "start": 7.53,
     "end": 10.67,
     "text": "The charges are listed. Leave them checked."
    },
    {
     "start": 10.67,
