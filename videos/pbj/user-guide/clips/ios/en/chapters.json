   "steps": [
    {
     "start": 0.0,
     "end": 7.0,
     "text": "Read the Terms of Service, and scroll all the way to the bottom."
    },
    {
     "start": 7.0,
     "end": 12.27,
     "text": "Then tap Disclaimer, and scroll that to the bottom too."
    },
    {
     "start": 12.27,
     "end": 14.97,
     "text": "Tap I Accept — Continue."
    },
    {
     "start": 14.97,
     "end": 23.17,
     "text": "After you accept, follow the next few screens until you reach Home. Then bring in a bank statement so Home fills in with your own numbers."
    }
   ]
  },
  {
   "id": "language",
   "title": "Change the language",
   "src": "language.mp4",
   "poster": "language.jpg",
   "duration": 26.63,
   "steps": [
    {
     "start": 0.0,
     "end": 2.97,
     "text": "To change the language, tap the menu."
    },
    {
     "start": 2.97,
     "end": 5.87,
     "text": "Tap Preferences."
    },
    {
     "start": 5.87,
     "end": 8.33,
     "text": "Tap Language."
    },
    {
     "start": 8.33,
     "end": 15.27,
     "text": "Pick a language from the list. Each one is shown in its own words, like Español for Spanish."
    },
    {
     "start": 15.27,
     "end": 23.37,
     "text": "The whole app switches right away. To switch back, tap Language again and pick English."
    },
    {
     "start": 23.37,
     "end": 25.83,
     "text": "Back in English."
    }
   ]
  },
  {
